buildMetaPackage <- function(metaPackageName,packages) {
text <- "" %>%
addLine("#' @keywords internal") %>%
addLine("\"_PACKAGE\"") %>%
addLine("## usethis namespace: start") %>%
addLine("") %>%
addLine("")
for (p in 1:length(packages)) {
pack <- packages[p]
library(pack,character.only=TRUE)
allFunctions <- utils::lsf.str(paste0("package:",pack))
for (i in 1:length(allFunctions)) {
func <- allFunctions[i]
if (func!="%>%") {
text <- text %>% addLine(paste0("#' @importFrom ",pack," ",func)) %>%
addLine("#' @export") %>%
addLine(paste(pack,func,sep="::"))
}
}
}
text <- text %>% addLine("## usethis namespace: end") %>%
addLine("NULL")
print(text)
writeLines(text,file(paste0("R/",metaPackageName,"-package.R")))
}
