library(improveR)
library(improveR)
library(improveR)
addLine <- function(text,line) {
text <- paste(text,line,sep="\n")
return(text)
}
packages <- c("improveRcore","improveRget")
text <- "" %>%
addLine("#' @keywords internal") %>%
addLine("\"_PACKAGE\"") %>%
addLine("## usethis namespace: start") %>%
addLine("") %>%
addLine("")
for (p in 1:length(packages)) {
pack <- packages[p]
allFunctions <- lsf.str(paste0("package:",pack))
for (i in 1:length(allFunctions)) {
func <- allFunctions[i]
if (func!="%>%") {
text <- addLine(paste0("#' @importFrom ",pack," ",func)) %>%
addLine("#' @export") %>%
addLine(paste(pack,func,sep="::"))
}
}
}
