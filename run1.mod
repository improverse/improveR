$PROBLEM    Improve123 CD25
$INPUT   C,DOSE,ID,TIME,TAD,AMT,RATE,DV,MDV,EVID,CMT,NTIME,BASE,AGE,SEX,WT,RACE,ALB,LDH,NEUT,LYM,CRP,TUMOR,SKINST,AEGR,CPIN,WORSTSKINST,WORSTAEGR,ATEZO,STUDY
$DATA      poolSet.csv IGNORE=C IGNORE=(ID.EQ.1001352,ID.EQ.1001354,ID.EQ.1001356)
$SUBROUTINE ADVAN13 TOL=12

$MODEL      
	NCOMP=3 
	COMP=(CENTRAL) ;1 CENTRAL
    COMP=(PERIPH) ;2 PERIPH
    COMP=(AUC)  
    
$PK 
   ;CALLFL = -2

;------------------Dataset----------------------
;1	 RO7296682 dose	 mg
;2 	 RO7122290 conc	 ug/mL
;3 	 	 	 cells/uL
;4 	  		 cells/uL
;5 	  		 cells/uL
;6           cells/uL
;7 	  		 cells/uL
;8 	 		 10^9/L
;9 	 BOR		 no UNIT 

;------------------Parameters--------------------
   CL  = THETA(1)*EXP(ETA(1)) 
   V1  = THETA(2)*EXP(ETA(2))
   Q   = THETA(3)*EXP(ETA(3))
   V2  = THETA(4)*EXP(ETA(4))
AUCSS=DOSE/CL
  ;Reparameterization
K10  = CL/V1
K12  = Q/V1
K21  = Q/V2

S1   = V1

$DES 
   C1 = A(1)/S1
   DADT(1)  = -K10*A(1) - K12 * A(1) + K21 * A(2)
   DADT(2)  = K12 * A(1) - K21 * A(2)
   DADT(3) = C1

$ERROR
CP=A(1)/S1
AUC = A(3) 
IPRED = CP
DEL=.0001
IF (IPRED.EQ.0) IPRED=CP+DEL

W = IPRED*THETA(5)
IRES = DV-IPRED
IWRES = IRES/W
Y = IPRED + (W*ERR(1)*EXP(ETA(5)))




$THETA  
 (0,.5)   ; 1  ~CL (L/day)
 (0,4.5)  ; 2  ~V1 (L)
 (0,0.8)  ; 3  ~Q (L/day)
 (0,2)    ; 4  ~V2 (L)
 (0,.3)   ; 5 ~ERR_prop (%)


$OMEGA BLOCK(2)
0.4      ;1 ~IIV_CL
0.2 0.3  ;2 ~IIV_V1

$OMEGA
0 FIX  ;3 ~IIV_Q
0.3    ;4 ~IIV_V3
0.3    ;5 ~IIV on ERR

$SIGMA  
1 FIX; ~RES

;$SIMUL (1)


$ESTIMATION MAXEVAL=9999 METHOD=1 INTERACTION SIGDIGITS=4 POSTHOC PRINT=5 NOABORT MSFO=run1.msf
$COVARIANCE UNCONDITIONAL PRINT=E MAT=S
$TABLE      ID STUDY ATEZO DOSE SEX RACE CPIN TUMOR ONEHEADER NOPRINT NOAPPEND FORMAT=s1PE13.7 FILE=catab1
$TABLE      ID AGE ALB LDH NEUT LYM CRP ONEHEADER NOPRINT  NOAPPEND FORMAT=s1PE13.7 FILE=cotab1
$TABLE      ID CL V1 V2 Q ETAs(1:LAST) ONEHEADER NOPRINT NOAPPEND FORMAT=s1PE13.7 FILE=patab1
$TABLE      ID DOSE TIME TAD AMT RATE EVID MDV PRED IWRES CWRES CWRESI NPDE AUC DV IPRED ONEHEADER NOPRINT NOAPPEND FORMAT=s1PE13.7 FILE=sdtab1
            
; Problem no. 2
$PROBLEM    Model simulations
$INPUT   C,DOSE,ID,TIME,TAD,AMT,RATE,DV,MDV,EVID,CMT,NTIME,BASE,AGE,SEX,WT,RACE,ALB,LDH,NEUT,LYM,CRP,TUMOR,SKINST,AEGR,CPIN,WORSTSKINST,WORSTAEGR,ATEZO,STUDY
$DATA      poolSet.csv IGNORE=C IGNORE=(ID.EQ.1001352,ID.EQ.1001354,ID.EQ.1001356) REWIND ;IGNORE=(ID.EQ.1352,ID.EQ.1354)
$MSFI      run1.msf
$SIMULATION (200202) ONLYSIM NSUB=200 TRUE=FINAL
$TABLE      ID DV MDV IPRED PRED DOSE TIME TAD EVID AGE SEX CPIN TUMOR STUDY ONEHEADER NOPRINT NOAPPEND FORMAT=s1PE13.7 FILE=simtab1
            